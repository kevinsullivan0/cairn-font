{
  "name": "Cairn material",
  "version": "1.12",
  "principles": [
    "Matte stone planes with shallow grooves and a small bevel",
    "Bronze marks actions and the focused line; copper marks large titles",
    "Sage, patina, amethyst, and steel have distinct jobs",
    "Readable body and code fonts; carved letters reserved for scale",
    "Layout uses a four-pixel spacing unit; no artwork behind reading text"
  ],
  "roles": {
    "stone": "bg",
    "stone-inset": "sidebar",
    "stone-raised": "alt",
    "stone-hover": "raised",
    "groove": "border",
    "ink": "fg",
    "ink-emphasis": "bold",
    "ink-muted": "muted",
    "bronze": "focus",
    "copper": "red",
    "ochre": "gold",
    "sage": "green",
    "patina": "cyan",
    "steel": "blue",
    "amethyst": "purple",
    "selection": "selection",
    "cursor-line": "active_line",
    "button-face": "button_face",
    "button-hover": "button_hover",
    "button-pressed": "button_pressed",
    "button-label": "button_label",
    "button-primary-label": "button_primary_label",
    "button-edge": "button_edge",
    "button-light": "button_light",
    "button-shadow": "button_shadow"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px"
  },
